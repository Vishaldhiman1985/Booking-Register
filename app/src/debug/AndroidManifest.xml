<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity
            android:name="com.example.bookingregister.reporting.property.debug.PropertyReportingDebugActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Property Reporting DEBUG" />

        <!-- Debug-only exported alias so ADB can open the real production report UI
             without launching BookingChartActivity or starting realtime sync. -->
        <activity-alias
            android:name="com.example.bookingregister.reporting.property.debug.PropertyReportUiDebugAlias"
            android:targetActivity="com.example.bookingregister.ui.reporting.RevenueReportActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="Property Report UI DEBUG" />
    </application>
</manifest>
