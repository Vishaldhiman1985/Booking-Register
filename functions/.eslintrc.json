{
  "root": true,
  "env": {
    "node": true,
    "es2022": true
  },
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "script"
  },
  "extends": ["eslint:recommended"],
  "rules": {
    "quotes": ["error", "double", { "allowTemplateLiterals": true }],
    "semi": ["error", "always"],
    "object-curly-spacing": ["error", "always"],
    "max-len": ["warn", { "code": 140, "ignoreComments": true, "ignoreStrings": true, "ignoreTemplateLiterals": true }]
  }
}
